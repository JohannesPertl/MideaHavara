# Telegram settings for local runs.
# Copy to .env on the Raspberry Pi and fill in the real values.
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789

# Optional on Raspberry Pi OS if Playwright should use system Chromium.
# Common values are /usr/bin/chromium or /usr/bin/chromium-browser.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
